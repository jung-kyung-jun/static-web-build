---
import { getEntry, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { formatDate, getPosts, monthLabel, monthPath, postPath } from '../../../../lib/posts';
import { withBase } from '../../../../lib/url';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => {
		const [year, month, slug] = post.id.split('/');
		return { params: { year, month, slug } };
	});
}

const { year, month, slug } = Astro.params;
const post = await getEntry('blog', `${year}/${month}/${slug}`);
if (!post || post.data.draft) {
	throw new Error(`글을 찾을 수 없습니다: ${year}/${month}/${slug}`);
}

const { Content } = await render(post);
const posts = await getPosts();
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
---

<Base title={post.data.title} description={post.data.description}>
	<article>
		<header class="article-head">
			<p class="kicker">
				<a href={withBase(monthPath(year!, month!))}>{monthLabel(year!, month!)}</a>
			</p>
			<h1>{post.data.title}</h1>
			<p class="meta">
				<time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
				<a href={withBase(`categories/${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a>
				{
					post.data.tags.map((tag) => (
						<a href={withBase(`tags/${encodeURIComponent(tag)}`)}>#{tag}</a>
					))
				}
			</p>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>

	<nav class="pager" aria-label="인접한 글">
		<div>
			{
				older && (
					<a href={withBase(postPath(older))}>
						<small>이전 글</small>
						{older.data.title}
					</a>
				)
			}
		</div>
		<div class="next">
			{
				newer && (
					<a href={withBase(postPath(newer))}>
						<small>다음 글</small>
						{newer.data.title}
					</a>
				)
			}
		</div>
	</nav>
</Base>
