---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TermList from '../../components/TermList.astro';
import { collectTerms, getPosts, groupByMonth, monthLabel, monthPath } from '../../lib/posts';
import { withBase } from '../../lib/url';

const posts = await getPosts();
const groups = groupByMonth(posts);
const categories = collectTerms(posts, (post) => [post.data.category]);
const tags = collectTerms(posts, (post) => post.data.tags);
---

<Base title="Blog" description="월별로 모은 글 목록과 태그, 카테고리.">
	<p class="kicker">Blog</p>
	<h1 class="page-title">모든 글</h1>
	<p class="page-intro">파일의 연·월 폴더를 기준으로 묶습니다. 태그 또는 카테고리를 고르면 그 글만 볼 수 있습니다.</p>

	{
		groups.length === 0 ? (
			<p class="empty">아직 공개된 글이 없습니다.</p>
		) : (
			groups.map((group) => (
				<section aria-labelledby={`month-${group.year}-${group.month}`}>
					<div class="month-heading">
						<h2 id={`month-${group.year}-${group.month}`}>
							<a href={withBase(monthPath(group.year, group.month))}>{monthLabel(group.year, group.month)}</a>
						</h2>
					</div>
					<PostList posts={group.posts} titleTag="h3" />
				</section>
			))
		)
	}

	<section class="taxonomy" aria-labelledby="categories-heading">
		<h2 id="categories-heading">카테고리</h2>
		<TermList terms={categories} basePath="categories" />
	</section>

	<section class="taxonomy" aria-labelledby="tags-heading">
		<h2 id="tags-heading">태그</h2>
		<TermList terms={tags} basePath="tags" />
	</section>
</Base>
