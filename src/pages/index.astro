---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TermList from '../components/TermList.astro';
import { collectTerms, getPosts } from '../lib/posts';
import { withBase } from '../lib/url';

const posts = await getPosts();
const recent = posts.slice(0, 4);
const categories = collectTerms(posts, (post) => [post.data.category]);
---

<Base title="Day 27" description="월별로 글을 쌓는 마크다운 노트. 태그, 카테고리, 정적 페이지.">
	<header class="hero">
		<p class="kicker">Notebook</p>
		<h1>월별로 쌓는<br />기록.</h1>
		<p class="lede">
			마크다운 파일을 연·월 폴더에 넣으면 글, 목록, 태그, 카테고리가 정적 페이지로 만들어집니다.
		</p>
	</header>

	<section aria-labelledby="recent-heading">
		<div class="section-head">
			<h2 id="recent-heading">최근 글</h2>
			<a href={withBase('blog')}>모든 글</a>
		</div>
		<PostList posts={recent} titleTag="h3" />
	</section>

	<section class="taxonomy" aria-labelledby="category-heading">
		<h2 id="category-heading">카테고리</h2>
		<TermList terms={categories} basePath="categories" />
	</section>
</Base>
