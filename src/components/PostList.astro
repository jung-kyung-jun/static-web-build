---
import type { Post } from '../lib/posts';
import { formatDate, postPath } from '../lib/posts';
import { withBase } from '../lib/url';

interface Props {
	posts: Post[];
	titleTag?: 'h2' | 'h3';
}

const { posts, titleTag = 'h2' } = Astro.props;
const Title = titleTag;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 공개된 글이 없습니다.</p>
	) : (
		<ol class="post-list">
			{posts.map((post) => (
				<li>
					<time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
					<div>
						<Title class="post-title">
							<a href={withBase(postPath(post))}>{post.data.title}</a>
						</Title>
						<p>{post.data.description}</p>
						<p class="meta">
							<a href={withBase(`categories/${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a>
							{post.data.tags.map((tag) => (
								<a href={withBase(`tags/${encodeURIComponent(tag)}`)}>#{tag}</a>
							))}
						</p>
					</div>
				</li>
			))}
		</ol>
	)
}
