---
import { normalizePath, withBase } from '../lib/url';

const pathname = normalizePath(Astro.url.pathname);
const links = [
	{ href: withBase(''), label: 'Home', match: 'exact' as const },
	{ href: withBase('about'), label: 'About', match: 'exact' as const },
	{ href: withBase('blog'), label: 'Blog', match: 'prefix' as const },
];

function isCurrent(href: string, match: 'exact' | 'prefix') {
	const target = normalizePath(href);
	if (match === 'exact') return pathname === target;
	return pathname === target || pathname.startsWith(`${target}/`);
}
---

<header class="site-header">
	<div class="shell nav-row">
		<a class="wordmark" href={withBase('')}>
			<strong>Day 27</strong>
			<span>Monthly notebook</span>
		</a>
		<nav aria-label="주 메뉴">
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href} aria-current={isCurrent(link.href, link.match) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
